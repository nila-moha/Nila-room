rules_version = '2';

// ============================================================
// Règles de sécurité Firebase Storage — BN CORE GROUP, App Chantier
// ============================================================
// À copier-coller dans Console Firebase > Storage > Règles.
//
// Isolation par équipe/client, en miroir des règles Firestore
// (isMyTeamProject / isMyClientProject) : sans ça, n'importe quel compte
// connecté et actif — même un ouvrier d'une autre équipe ou le client
// d'un autre chantier — pourrait lire ou écrire les photos de N'IMPORTE
// QUEL projet en appelant directement le SDK Storage avec l'ID d'un
// projet qui n'est pas le sien (les clés Firebase côté navigateur ne
// sont pas secrètes ; seules ces règles empêchent ça). Une version
// précédente de ce fichier autorisait tout compte actif sans cette
// vérification — corrigé.
//
// SECOURS : si la console Firebase refuse ces règles au moment de les
// coller (syntaxe "firestore.get" indisponible sur votre version),
// dites-le-moi avant d'utiliser une version simplifiée — une règle
// moins précise rouvrirait exactement la faille ci-dessus.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function person() {
      return firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data;
    }
    function isActive() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/people/$(request.auth.uid)) &&
        person().revoked != true;
    }
    function isAdmin() { return isActive() && person().role == 'admin'; }

    match /projects/{projectId}/{allPaths=**} {
      function project() {
        return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      }
      function isMyTeamProject() {
        return isActive() && person().teamId != null && project().teamId == person().teamId;
      }
      function isMyClientProject() {
        return isActive() && person().clientId != null && project().clientId == person().clientId;
      }
      allow read, write: if isAdmin() || isMyTeamProject() || isMyClientProject();
    }
  }
}
