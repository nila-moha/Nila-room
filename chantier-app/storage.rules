rules_version = '2';

// ============================================================
// Règles de sécurité Firebase Storage — BN CORE GROUP, App Chantier
// ============================================================
// À copier-coller dans Console Firebase > Storage > Règles.
//
// Isolation par équipe/client, en miroir des règles Firestore : sans ça,
// n'importe quel compte connecté et actif — même un ouvrier d'une autre
// équipe ou le client d'un autre chantier — pourrait lire ou écrire les
// photos de N'IMPORTE QUEL projet en appelant directement le SDK Storage
// avec l'ID d'un projet qui n'est pas le sien (les clés Firebase côté
// navigateur ne sont pas secrètes ; seules ces règles empêchent ça).
//
// Chaque fonction ci-dessous appelle firestore.get()/exists()
// DIRECTEMENT, sans passer par une autre fonction intermédiaire : une
// version précédente chaînait plusieurs fonctions avant d'atteindre le
// firestore.get() réel (isAdmin -> isActive -> person() -> get()), et
// cette indirection faisait échouer silencieusement TOUTES les
// vérifications en production (un vrai ouvrier de la bonne équipe se
// voyait refuser l'accès à ses propres photos), sans lien avec la
// logique elle-même — vérifié empiriquement avec de vrais comptes
// signés, pas seulement le simulateur de règles. Rester au plus près de
// cette forme plate si ce fichier est modifié à nouveau.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/people/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data.revoked != true &&
        firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data.role == 'admin';
    }

    // Certificats d'étalonnage des outils : admin uniquement (le personnel
    // voit la date de validité dans Firestore, pas besoin du fichier).
    match /tools/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Documents de conformité (Limosa, A1, VCA, habilitation) : l'admin les
    // dépose ; l'ouvrier peut relire les siens ; taille limitée (photo/PDF).
    match /compliance/{uid}/{file} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin() && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }

    match /projects/{projectId}/{allPaths=**} {
      function isMyTeamProject() {
        return isSignedIn() &&
          firestore.exists(/databases/(default)/documents/people/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data.revoked != true &&
          firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data.teamId != null &&
          firestore.get(/databases/(default)/documents/projects/$(projectId)).data.teamId ==
            firestore.get(/databases/(default)/documents/people/$(request.auth.uid)).data.teamId;
      }
      // Admin : tout, y compris la suppression (purge des durées de
      // conservation, voir js/retention.js).
      allow read, write: if isAdmin();
      // Équipe du projet : lire et AJOUTER des photos (JPEG redimensionnés
      // par l'app), jamais écraser ni supprimer celles d'un collègue.
      allow read: if isMyTeamProject();
      allow create: if isMyTeamProject() &&
        resource == null &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 15 * 1024 * 1024;
      // Client : AUCUN accès direct au stockage. Il voit les photos des
      // rapports qui lui sont montrés via leur lien de téléchargement signé
      // (enregistré dans Firestore), sans passer par ces règles. Avant, un
      // client pouvait lister et télécharger les photos de pointage et les
      // reçus d'achat des ouvriers — contraire à la notice RGPD — et même
      // écraser ou supprimer n'importe quelle photo de son projet.
    }
  }
}
