rules_version = '2';

// ============================================================
// Règles de sécurité Firestore — BN CORE GROUP, App Chantier
// ============================================================
// À copier-coller dans Console Firebase > Firestore Database > Règles.
//
// Logique :
//  - "admin" (vous) voit et modifie tout.
//  - Un membre d'équipe (engineer/electrician/worker) ne voit que les
//    projets assignés à SON équipe (teamId).
//  - Un client ne voit que les projets liés à SON client (clientId), et
//    uniquement le contenu marqué "visibleToClient".
//  - Une personne peut créer SON PROPRE profil uniquement si elle
//    possède un code d'invitation valide et non utilisé qui correspond
//    exactement au rôle/équipe/client réclamés (auto-inscription
//    encadrée — voir /invites plus bas). Toute autre écriture sur
//    /people est réservée à l'admin.
//  - "revoked: true" sur un profil coupe tous les accès aux données
//    (mais laisse le compte de connexion Firebase intact — c'est
//    volontaire : l'historique et les données restent, seul l'accès
//    est retiré).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Firestore's rule engine reliably resolves get()/exists() only a
    // shallow number of custom-function hops deep — the previous version
    // of this file chained personRef() -> hasPerson()/myPerson() ->
    // isActive() -> isAdmin() (get() four functions removed from the
    // rule that used it), and every rule built on isAdmin() silently
    // failed with "Missing or insufficient permissions" in production,
    // even for a real admin account, while the identical get() written
    // directly (or one function hop away) worked fine. Flattened so
    // get()/exists() are called directly by isActive()/myPerson(),
    // confirmed working end-to-end before this was adopted everywhere.
    function myPerson() {
      return get(/databases/$(database)/documents/people/$(request.auth.uid)).data;
    }
    function isActive() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/people/$(request.auth.uid)) &&
        myPerson().revoked != true;
    }

    function isAdmin() { return isActive() && myPerson().role == 'admin'; }
    function myTeamId() { return myPerson().teamId; }
    function myClientId() { return myPerson().clientId; }

    // Seuls les champs de la file de photos hors connexion changent
    // (js/offline-photos.js) : ajout d'URL, décompte des photos en attente.
    function onlyPhotoQueue(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field, 'pendingPhotos']);
    }

    function projectOf(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function isMyTeamProject(projectId) {
      return isActive() && myTeamId() != null && projectOf(projectId).teamId == myTeamId();
    }
    function isMyClientProject(projectId) {
      return isActive() && myClientId() != null && projectOf(projectId).clientId == myClientId();
    }

    // An invite matching exactly the role/team/client a self-signing-up
    // person is claiming for themselves, and not yet used.
    function validInviteFor(data) {
      let invite = get(/databases/$(database)/documents/invites/$(data.inviteCode)).data;
      return invite.used == false &&
        invite.role == data.role &&
        invite.teamId == data.teamId &&
        invite.clientId == data.clientId;
    }

    // The same invite, as it will stand once the signup batch commits:
    // marked used by this very person. Forces the profile creation and the
    // invite consumption into one atomic batch, so one link can no longer
    // create several accounts by skipping the "mark as used" write.
    function inviteConsumedBy(code, uid) {
      let after = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return after.used == true && after.usedBy == uid;
    }

    // ---- People (accounts) ----
    match /people/{personId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == personId);
      allow create: if isAdmin() ||
        (isSignedIn() && request.auth.uid == personId &&
         request.resource.data.role != 'admin' &&
         request.resource.data.revoked == false &&
         validInviteFor(request.resource.data) &&
         inviteConsumedBy(request.resource.data.inviteCode, personId));
      allow update, delete: if isAdmin();
      // Une personne active peut enregistrer elle-même sa confirmation de la
      // notice RGPD (preuve de remise de l'information) — et rien d'autre
      // sur son profil (rôle, équipe, révocation restent réservés à l'admin).
      allow update: if isActive() && request.auth.uid == personId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['noticeVersion', 'noticeLang', 'noticeAcceptedAt']) &&
        request.resource.data.noticeAcceptedAt == request.time;
    }

    // ---- Invites ----
    // "get" (reading one exact code) is open so a not-yet-authenticated
    // visitor can validate their invite link before creating an account —
    // the random code itself is the secret, like a password-reset link.
    // "list" (browsing all invites) stays admin-only.
    match /invites/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.clientId == resource.data.clientId &&
        // Only consumable by the signup that creates the matching profile
        // in the same batch (stops anyone who learns a code from burning it).
        getAfter(/databases/$(database)/documents/people/$(request.auth.uid)).data.inviteCode == code;
    }

    // ---- Jetons de notification push (js/push.js) ----
    // Chacun enregistre / retire les jetons de SES téléphones ; personne ne
    // peut les lire depuis l'app (seul le serveur, functions/, les utilise).
    match /pushTokens/{token} {
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if isActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Outillage et étalonnage (js/evidence.js) ----
    // Lisible par le personnel (choix de l'outil sur le terrain), pas par
    // les clients ; géré par l'admin.
    match /tools/{toolId} {
      allow read: if isAdmin() || (isActive() && myTeamId() != null);
      allow write: if isAdmin();
    }

    // ---- Paramètres internes (ex. suivi de la purge de conservation) ----
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ---- Demandes de personnel (js/staffing.js) ----
    // Le client crée et suit SES demandes (et peut annuler tant qu'elle est
    // « pending ») ; l'admin décide (choisir les personnes ou ouvrir aux
    // volontaires) ; le personnel ne voit que les missions ouvertes à tous
    // ou à SON équipe, et ne peut que s'y inscrire / s'en retirer lui-même.
    match /staffRequests/{reqId} {
      allow get, list: if isAdmin();
      allow get, list: if isActive() && myClientId() != null && resource.data.clientId == myClientId();
      allow get, list: if isActive() && myTeamId() != null && resource.data.status == 'open' &&
        (resource.data.audience == 'all' || resource.data.teamId == myTeamId());
      allow create: if isActive() && myPerson().role == 'client' &&
        request.resource.data.clientId == myClientId() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.peopleNeeded is int &&
        request.resource.data.peopleNeeded >= 1 && request.resource.data.peopleNeeded <= 50 &&
        request.resource.data.startDate is string && request.resource.data.endDate is string &&
        request.resource.data.startDate <= request.resource.data.endDate &&
        request.resource.data.work is string && request.resource.data.work.size() > 0 &&
        request.resource.data.address is string && request.resource.data.address.size() > 0 &&
        request.resource.data.startTime is string && request.resource.data.startTime.size() > 0 &&
        (request.resource.data.projectId == null ||
          get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.clientId == myClientId());
      allow update: if isAdmin();
      allow update: if isActive() && myClientId() != null && resource.data.clientId == myClientId() &&
        resource.data.status == 'pending' && request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();

      match /volunteers/{uid} {
        allow read: if isAdmin() ||
          (isActive() && myTeamId() != null &&
           get(/databases/$(database)/documents/staffRequests/$(reqId)).data.status == 'open' &&
           (get(/databases/$(database)/documents/staffRequests/$(reqId)).data.audience == 'all' ||
            get(/databases/$(database)/documents/staffRequests/$(reqId)).data.teamId == myTeamId()));
        allow create: if isActive() && myTeamId() != null && uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          get(/databases/$(database)/documents/staffRequests/$(reqId)).data.status == 'open' &&
          (get(/databases/$(database)/documents/staffRequests/$(reqId)).data.audience == 'all' ||
           get(/databases/$(database)/documents/staffRequests/$(reqId)).data.teamId == myTeamId());
        allow delete: if isAdmin() ||
          (isActive() && uid == request.auth.uid &&
           get(/databases/$(database)/documents/staffRequests/$(reqId)).data.status == 'open');
      }
    }

    // ---- Teams ----
    match /teams/{teamId} {
      allow read: if isAdmin() || (isActive() && myTeamId() == teamId);
      allow write: if isAdmin();
    }

    // ---- Clients ----
    match /clients/{clientId} {
      allow read: if isAdmin() || (isActive() && myClientId() == clientId);
      allow write: if isAdmin();
    }

    // ---- Comptes de facturation matériel (ex. BN CORE, Sungrow Benelux) ----
    // À donner en magasin lors d'un achat. Lisible par l'équipe (pas les
    // clients, qui n'en ont pas besoin) ; modifiable par l'admin seul.
    match /billingEntities/{entityId} {
      allow get, list: if isAdmin() || (isActive() && myPerson().role != 'client');
      allow write: if isAdmin();
    }

    // ---- Assignments (planning) ----
    // Qui va sur quel chantier, quel jour. L'admin gère tout ; une personne
    // voit ses propres créneaux ET ceux de sa propre équipe (pour savoir
    // avec qui elle travaille tel jour) — jamais ceux d'une autre équipe,
    // ni les clients.
    match /assignments/{assignmentId} {
      allow get, list: if isAdmin() ||
        (isActive() && (resource.data.personUid == request.auth.uid ||
          (myTeamId() != null && resource.data.teamId == myTeamId())));
      allow write: if isAdmin();
    }

    // ---- Projects ----
    match /projects/{projectId} {
      // Split into separate "allow" statements (rather than one big ||)
      // and checked directly against resource.data instead of re-fetching
      // this same document via isMyTeamProject/isMyClientProject: mixing a
      // data-independent admin check with data-dependent ones in a single
      // expression made Firestore reject the admin's unfiltered list query
      // outright (a real, observed bug, not just a style preference) —
      // each admin/team/client case now stands as its own simple rule.
      allow get, list: if isAdmin();
      allow get, list: if isActive() && myTeamId() != null && resource.data.teamId == myTeamId();
      allow get, list: if isActive() && myClientId() != null && resource.data.clientId == myClientId();
      allow write: if isAdmin();

      // Étape validée = preuve figée : l'équipe ne peut plus la modifier
      // (sauf l'arrivée des photos restées hors connexion) ; l'admin rouvre.
      match /checklist/{stepId} {
        allow read: if isAdmin() || isMyTeamProject(projectId) || isMyClientProject(projectId);
        allow create: if isAdmin() || isMyTeamProject(projectId);
        allow update: if isAdmin() ||
          (isMyTeamProject(projectId) && resource.data.done != true &&
            (request.resource.data.done != true ||
              (request.resource.data.doneByUid == request.auth.uid &&
               request.resource.data.doneAt == request.time &&
               request.resource.data.evidence is map))) ||
          (isMyTeamProject(projectId) && onlyPhotoQueue('evidencePhotos'));
        allow delete: if isAdmin();
      }

      match /journal/{entryId} {
        allow read: if isAdmin() || isMyTeamProject(projectId) ||
          (isMyClientProject(projectId) && resource.data.visibleToClient == true);
        allow create: if isAdmin() || isMyTeamProject(projectId);
        allow update, delete: if isAdmin();
        allow update: if isMyTeamProject(projectId) && resource.data.authorUid == request.auth.uid && onlyPhotoQueue('photoUrls');
      }

      match /problems/{problemId} {
        allow read: if isAdmin() || isMyTeamProject(projectId) ||
          (isMyClientProject(projectId) && resource.data.visibleToClient == true);
        allow create: if isAdmin() || isMyTeamProject(projectId);
        allow update: if isAdmin();
        allow update: if isMyTeamProject(projectId) && resource.data.reportedByUid == request.auth.uid && onlyPhotoQueue('photoUrls');
        // Réserve levée par BN CORE : seul le client l'accepte ou la refuse.
        allow update: if isMyClientProject(projectId) && resource.data.visibleToClient == true &&
          resource.data.status == 'resolved' &&
          ((request.resource.data.status == 'accepted' && request.resource.data.acceptedByUid == request.auth.uid &&
            request.resource.data.acceptedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedByName', 'acceptedByUid', 'acceptedAt'])) ||
           (request.resource.data.status == 'published' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'clientRejectReason'])));
        allow delete: if isAdmin();
      }

      match /requests/{requestId} {
        allow read: if isAdmin() || isMyTeamProject(projectId) || isMyClientProject(projectId);
        allow create: if isAdmin() || isMyClientProject(projectId);
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Pointages : une personne ne pointe qu'en son propre nom (personUid),
      // jamais pour un collègue — ces heures servent à la facturation client.
      match /timesheets/{entryId} {
        allow read: if isAdmin() || isMyTeamProject(projectId);
        allow create: if isAdmin() ||
          (isMyTeamProject(projectId) && request.resource.data.personUid == request.auth.uid);
        allow update, delete: if isAdmin();
        allow update: if isMyTeamProject(projectId) && resource.data.personUid == request.auth.uid && onlyPhotoQueue('photoUrls');
      }

      // Kilométrage domicile-chantier saisi par chaque personne, utile pour
      // la facturation des frais de déplacement (même logique d'accès que
      // les pointages : chacun n'écrit qu'en son propre nom, seul l'admin
      // corrige/efface).
      match /mileage/{entryId} {
        allow read: if isAdmin() || isMyTeamProject(projectId);
        allow create: if isAdmin() ||
          (isMyTeamProject(projectId) && request.resource.data.personUid == request.auth.uid);
        allow update, delete: if isAdmin();
      }

      // Achats de matériel signalés par l'équipe (magasin, montant, photo du
      // reçu) — pour que l'admin sache quelles factures attendre. Même
      // logique d'accès que le kilométrage.
      match /purchases/{purchaseId} {
        allow read: if isAdmin() || isMyTeamProject(projectId);
        allow create: if isAdmin() || isMyTeamProject(projectId);
        allow update, delete: if isAdmin();
        allow update: if isMyTeamProject(projectId) && resource.data.reportedByUid == request.auth.uid && onlyPhotoQueue('photoUrls');
      }

      // Procès-verbal de réception signé par le client (js/evidence.js) :
      // une seule fois, à son nom, à l'heure du serveur ; jamais modifiable.
      match /handover/{docId} {
        allow read: if isAdmin() || isMyTeamProject(projectId) || isMyClientProject(projectId);
        allow create: if docId == 'pv' && isMyClientProject(projectId) &&
          request.resource.data.signedByUid == request.auth.uid &&
          request.resource.data.signedAt == request.time &&
          request.resource.data.signaturePng is string && request.resource.data.signaturePng.size() < 300000;
        allow delete: if isAdmin();
      }

      // Frais d'hébergement/repas facturés au client — saisis par l'admin
      // uniquement. Ce n'est pas ce qui est payé à l'ouvrier, donc jamais
      // lisible ni modifiable par l'équipe ou le client, contrairement au
      // kilométrage qui est saisi par chacun.
      match /expenses/{personId} {
        allow read, write: if isAdmin();
      }

      // Avis de satisfaction client, laissé à la clôture du projet (doc
      // fixe "avis"). Le client ne peut écrire que tant que le projet est
      // clôturé — pas avant, pas pour se corriger indéfiniment après coup
      // sans repasser par l'admin.
      match /feedback/{feedbackId} {
        allow read: if isAdmin() || isMyTeamProject(projectId) || isMyClientProject(projectId);
        allow create, update: if isAdmin() ||
          (isMyClientProject(projectId) && projectOf(projectId).status == 'closed');
        allow delete: if isAdmin();
      }
    }
  }
}
